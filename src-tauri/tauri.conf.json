{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deckless",
  "version": "0.1.0",
  "identifier": "app.deckless.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Deckless",
    "shortDescription": "Stream Deck bez Stream Decku",
    "longDescription": "Panel tlačítek u kurzoru myši: zkratky, média, zvuk, okna, OBS a pluginy pro Stream Deck.",
    "category": "Utility",
    "fileAssociations": [
      {
        "ext": ["streamDeckPlugin"],
        "name": "Stream Deck Plugin",
        "description": "Stream Deck plugin",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Czech", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
